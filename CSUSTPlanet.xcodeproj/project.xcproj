{
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": { "anchor": "Configs", "relative-path": "Shared.xcconfig" } },
    { "name": "Release", "file": { "anchor": "Configs", "relative-path": "Shared.xcconfig" } },
  ],
  "localizations": {
    "development": "zh-Hans",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/gonzalezreal/swift-markdown-ui.git",
      "version": {
        "up-to-next-major-version": "2.4.1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/zHElEARN/CSUSTKit.git",
      "version": {
        "branch": "main",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/matomo-org/matomo-sdk-ios.git",
      "version": {
        "branch": "v7.8.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/onevcat/Kingfisher.git",
      "version": {
        "up-to-next-major-version": "8.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/zHElEARN/AlertToast.git",
      "version": {
        "branch": "master",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/groue/GRDB.swift.git",
      "version": {
        "up-to-next-major-version": "7.10.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/auth0/JWTDecode.swift",
      "version": {
        "up-to-next-major-version": "4.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/Tencent/MMKV.git",
      "version": {
        "up-to-next-major-version": "2.4.2",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/QMUI/LookinServer.git",
      "version": {
        "up-to-next-major-version": "1.2.8",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/siteline/swiftui-introspect.git",
      "version": {
        "up-to-next-major-version": "27.0.0",
      },
    },
  ],
  "files": [
    {
      "kind": "folder",
      "path": "Configs",
      "target-membership": [
        "CSUSTPlanet",
      ],
      "membership-exceptions": [
        {
          "target": "CSUSTPlanet",
          "exclusions": [
            "Shared.xcconfig",
            "User.xcconfig",
            "User.xcconfig.template",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "CSUSTPlanet",
      "target-membership": [
        "CSUSTPlanet",
      ],
      "membership-exceptions": [
        {
          "target": "CSUSTPlanet",
          "exclusions": [
            "App/Info.plist",
          ],
        }, {
          "target": "CSUSTPlanetWidgetExtension",
          "inclusions": [
            "Database/DatabaseManager.swift",
            "Database/Models/CustomCourseGRDB.swift",
            "Database/Models/CustomCourseScheduleGRDB.swift",
            "Database/Models/CustomSessionGRDB.swift",
            "Database/Models/Dorm.swift",
            "Database/Models/ElectricityRecord.swift",
            "Database/Models/MatomoEvent.swift",
            "Extensions/Color+Hex.swift",
            "Extensions/DayOfWeek+Formatter.swift",
            "Extensions/Logger+Categories.swift",
            "Extensions/Views/View+Apply.swift",
            "Extensions/Views/View+Toolbar.swift",
            "Helpers/CookieHelper.swift",
            "Helpers/MMKV/MMKVHelper+LogHandler.swift",
            "Helpers/MMKV/MMKVHelper+Storage.swift",
            "Helpers/MMKV/MMKVHelper.swift",
            "Helpers/Track/MatomoGRDBQueue.swift",
            "Helpers/Track/MatomoLogger.swift",
            "Helpers/Track/TrackHelper.swift",
            "Helpers/WebVPNTrustHelper.swift",
            "Managers/AuthManager+RetryProtocol.swift",
            "Models/AssignmentsData.swift",
            "Models/Cached.swift",
            "Models/CourseScheduleData.swift",
            "Models/GradeAnalysisData.swift",
            "Utils/AssetUtil.swift",
            "Utils/ColorUtil.swift",
            "Utils/Constants.swift",
            "Utils/CourseScheduleUtil.swift",
            "Utils/ElectricityUtil.swift",
            "Utils/EnvironmentUtil.swift",
            "Utils/KeychainUtil.swift",
            "Utils/PlatformAliases.swift",
            "Utils/RelativeDateStyle.swift",
            "Views/LastUpdatedDateView.swift",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "CSUSTPlanetWidget",
      "target-membership": [
        "CSUSTPlanetWidgetExtension",
      ],
      "membership-exceptions": [
        {
          "target": "CSUSTPlanet",
          "inclusions": [
            "LiveActivities/CourseStatusWidgetLiveActivity.swift",
          ],
        }, {
          "target": "CSUSTPlanetWidgetExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<SDK>/System/Library/Frameworks/WidgetKit.framework", "target-membership": [ "CSUSTPlanetWidgetExtension/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/SwiftUI.framework", "target-membership": [ "CSUSTPlanetWidgetExtension/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/CSUSTPlanet.app", "id": "007CF85B2E1BD68900E319F2", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/CSUSTPlanetWidgetExtension.appex", "id": "00E89C602E2C88D800B43162", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "CSUSTPlanet/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "CSUSTPlanet",
      "id": "007CF85A2E1BD68900E319F2",
      "product": "Products/CSUSTPlanet.app",
      "product-type": "application",
      "dependencies": [
        "CSUSTPlanetWidgetExtension",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        }, {
          "kind": "script",
          "name": "Generate Licenses (LicensePlist)",
          "run-on-every-build": true,
          "scope": "install",
          "shell": "/bin/sh",
          "script": [
            "OUTPUT_DIR=\"$TARGET_BUILD_DIR/$UNLOCALIZED_RESOURCES_FOLDER_PATH/com.mono0926.LicensePlist.Output\"",
            "mkdir -p \"$OUTPUT_DIR\"",
            "/opt/homebrew/bin/license-plist --output-path \"$OUTPUT_DIR\" --github-token \"$LICENSE_PLIST_GITHUB_TOKEN\" --suppress-opening-directory",
            "",
          ],
        },
      ],
      "package-product-members": [
        {
          "package": "AlertToast",
          "product-name": "AlertToast",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "CSUSTKit",
          "product-name": "CSUSTKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "GRDB.swift",
          "product-name": "GRDB",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "JWTDecode",
          "product-name": "JWTDecode",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Kingfisher",
          "product-name": "Kingfisher",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "LookinServer",
          "product-name": "LookinServer",
          "build-phase": { "build-phase": "frameworks", "platforms": [ "ios" ] },
        }, {
          "package": "MMKV",
          "product-name": "MMKV",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "matomo-sdk-ios",
          "product-name": "MatomoTracker",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-markdown-ui",
          "product-name": "MarkdownUI",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swiftui-introspect",
          "product-name": "SwiftUIIntrospect",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
