        "PROVISIONING_PROFILE_SPECIFIER[config=Debug][sdk=macosx*]": "match Development com.zhelearn.CSUSTPlanet macos",
        "PROVISIONING_PROFILE_SPECIFIER[config=Release]": "",
        "PROVISIONING_PROFILE_SPECIFIER[config=Release][sdk=iphoneos*]": "match AppStore com.zhelearn.CSUSTPlanet",
        "PROVISIONING_PROFILE_SPECIFIER[config=Release][sdk=macosx*]": "match AppStore com.zhelearn.CSUSTPlanet macos",
        "REGISTER_APP_GROUPS": "YES",
